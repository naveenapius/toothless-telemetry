// config.h.example — template. Copy to config.h and fill in your real values:
//
//     cp include/config.h.example include/config.h
//
// config.h is GITIGNORED (it holds your WiFi + broker credentials), so your
// secrets never get committed. main.cpp includes config.h and reads these.

#pragma once

// --- WiFi (must be a 2.4 GHz network — the ESP32-S3 radio is 2.4 GHz only) ---
#define WIFI_SSID   "YOUR_WIFI_SSID"
#define WIFI_PASS   "YOUR_WIFI_PASSWORD"

// --- MQTT broker (Mosquitto on your Mac) ------------------------------------
// MQTT_HOST = the Mac's LAN IP, from:  ipconfig getifaddr en0
#define MQTT_HOST    "192.168.1.42"
#define MQTT_PORT    1883
#define MQTT_USER    "toothless"            // the mosquitto_passwd username
#define MQTT_PASS    "YOUR_BROKER_PASSWORD"
#define MQTT_CLIENT  "toothless-esp32"      // this device's MQTT client id (must be unique)
#define MQTT_TOPIC   "toothless/heartbeat"  // topic the heartbeat is published to

// --- Heartbeat timing -------------------------------------------------------
#define HEARTBEAT_MS 10000UL                // publish every 10 s
