# Toothless Telemetry — pipeline secrets TEMPLATE (safe to commit; NO real values).
#
# Copy to `.env` ON THE BOX and fill with generated secrets. The real `.env` is gitignored
# and never committed. Docker Compose auto-loads `.env` from this directory for ${VAR}
# substitution in docker-compose.yml.
#
# Generate strong random values on the box, e.g.:
#   INFLUX_ADMIN_PASSWORD / MQTT_TELEGRAF_PASSWORD : openssl rand -base64 24
#   INFLUX_ADMIN_TOKEN                             : openssl rand -hex 32
# Store all of them in the password manager.
#
# NOTE: MQTT_TELEGRAF_PASSWORD must ALSO be registered on the broker for the `telegraf`
# user:  mosquitto_passwd passwd telegraf   (no -c, so it doesn't clobber `toothless`).

# InfluxDB first-boot admin (used to log into the UI and as the write token):
INFLUX_ADMIN_USER=toothless
INFLUX_ADMIN_PASSWORD=change-me
INFLUX_ADMIN_TOKEN=change-me

# Broker password for the read-only Telegraf bridge user:
MQTT_TELEGRAF_PASSWORD=change-me
